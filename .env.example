# Supabase (Project Settings > API Keys)
# SUPABASE_ANON_KEY / VITE_SUPABASE_ANON_KEY = Publishable key (sb_publishable_...)
# SUPABASE_SERVICE_ROLE_KEY = Secret key (sb_secret_...). NUNCA en el navegador ni en el repositorio.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Clave para cifrar los tokens de Meta. Generar con: npm run clave
TOKEN_ENCRYPTION_KEY=
# Secreto interno entre los cron y la función de sincronización (cualquier texto largo al azar)
SYNC_SECRET=
META_API_VERSION=v23.0

# Análisis con IA (Fase 2)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
